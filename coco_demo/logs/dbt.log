create or replace semantic view COCO_LIVE_DB.DBT_MARTS.sv_assignment_360
  
TABLES(
    COCO_LIVE_DB.DBT_MARTS.assignment_360
        COLUMNS(
            assignment_id COMMENT 'Unique identifier for the reconciliation assignment',
            assignment_type COMMENT 'Type of assignment (Balance, Flux, Activity)',
            combo_name COMMENT 'Account combination name',
            currency COMMENT 'Currency of the assignment',
            segment1 COMMENT 'First account segment',
            segment2 COMMENT 'Second account segment',
            segment3 COMMENT 'Third account segment',
            entity_id COMMENT 'Entity identifier',
            entity_name COMMENT 'Name of the associated entity',
            entity_code COMMENT 'Code of the associated entity',
            status COMMENT 'Current status of the assignment (Active/Inactive)',
            variance_risk COMMENT 'Variance risk classification (High/Medium/Low)',
            reconciliation_status COMMENT 'Current reconciliation status',
            period_id COMMENT 'Period identifier',
            period_end_date COMMENT 'End date of the reconciliation period',
            period_year COMMENT 'Year of the reconciliation period',
            period_quarter COMMENT 'Quarter of the reconciliation period',
            balance_gl COMMENT 'General ledger balance',
            balance_bank COMMENT 'Bank balance',
            balance_subledger COMMENT 'Subledger balance',
            total_variance COMMENT 'Total variance amount',
            unreconciled_amount COMMENT 'Unreconciled amount',
            reconciliation_count COMMENT 'Count of reconciliation records'
        )
        PRIMARY KEY (assignment_id, period_id)
        COMMENT 'Assignment-level 360 view with detailed reconciliation and variance data'
)
DIMENSIONS(
    assignment_360.assignment_id SYNONYMS ('assignment identifier', 'assignment number'),
    assignment_360.assignment_type SYNONYMS ('type', 'assignment category'),
    assignment_360.combo_name SYNONYMS ('combination name', 'account combo'),
    assignment_360.currency SYNONYMS ('currency code', 'transaction currency'),
    assignment_360.segment1 SYNONYMS ('segment 1', 'account segment 1'),
    assignment_360.segment2 SYNONYMS ('segment 2', 'account segment 2'),
    assignment_360.segment3 SYNONYMS ('segment 3', 'account segment 3'),
    assignment_360.entity_id SYNONYMS ('org id'),
    assignment_360.entity_name SYNONYMS ('organization', 'company'),
    assignment_360.entity_code SYNONYMS ('entity number', 'org code'),
    assignment_360.status SYNONYMS ('assignment status', 'current status'),
    assignment_360.variance_risk SYNONYMS ('risk level', 'variance risk level'),
    assignment_360.reconciliation_status SYNONYMS ('recon status', 'reconciliation state'),
    assignment_360.period_end_date SYNONYMS ('period date', 'close date'),
    assignment_360.period_year SYNONYMS ('year', 'fiscal year'),
    assignment_360.period_quarter SYNONYMS ('quarter', 'fiscal quarter')
)
FACTS(
    assignment_360.balance_gl SYNONYMS ('gl balance', 'general ledger'),
    assignment_360.balance_bank SYNONYMS ('bank balance', 'cash balance'),
    assignment_360.balance_subledger SYNONYMS ('subledger balance', 'subsidiary balance'),
    assignment_360.total_variance SYNONYMS ('variance', 'variance amount'),
    assignment_360.unreconciled_amount SYNONYMS ('unreconciled', 'outstanding balance'),
    assignment_360.reconciliation_count SYNONYMS ('recon count', 'number of reconciliations')
)
METRICS(
    sum_gl_balance AS SUM(assignment_360.balance_gl) SYNONYMS ('total gl', 'aggregate gl') COMMENT 'Sum of GL balances',
    sum_bank_balance AS SUM(assignment_360.balance_bank) SYNONYMS ('total bank', 'aggregate bank') COMMENT 'Sum of bank balances',
    sum_variance AS SUM(assignment_360.total_variance) SYNONYMS ('total variance', 'aggregate variance') COMMENT 'Sum of variance amounts',
    sum_unreconciled AS SUM(assignment_360.unreconciled_amount) SYNONYMS ('total unreconciled', 'aggregate unreconciled') COMMENT 'Sum of unreconciled amounts',
    count_assignments AS COUNT(DISTINCT assignment_360.assignment_id) SYNONYMS ('assignment count', 'total assignments') COMMENT 'Count of assignments',
    count_high_risk AS COUNT(CASE WHEN assignment_360.variance_risk = 'High' THEN 1 END) SYNONYMS ('high risk count', 'risky assignments') COMMENT 'Count of high variance risk assignments',
    count_needs_review AS COUNT(CASE WHEN assignment_360.reconciliation_status = 'Needs Review' THEN 1 END) SYNONYMS ('review count', 'needs attention') COMMENT 'Count of assignments needing review',
    avg_variance AS AVG(assignment_360.total_variance) SYNONYMS ('average variance', 'mean variance') COMMENT 'Average variance amount'
)
COMMENT = 'Comprehensive assignment-level 360 view for financial reconciliation analysis'
