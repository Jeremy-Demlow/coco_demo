create or replace semantic view COCO_LIVE_DB.DBT_MARTS.sv_entity_360
  
TABLES(
    COCO_LIVE_DB.DBT_MARTS.entity_360
        COLUMNS(
            entity_id COMMENT 'Unique identifier for the organization entity',
            entity_code COMMENT 'Business code for the entity',
            entity_name COMMENT 'Name of the organization entity',
            entity_type COMMENT 'Type classification of the entity',
            parent_name COMMENT 'Name of the parent entity in the hierarchy',
            hierarchy_depth COMMENT 'Depth level in the organization hierarchy',
            variance_risk_level COMMENT 'Risk classification based on variance amount (High/Medium/Low)',
            period_id COMMENT 'Period identifier',
            period_end_date COMMENT 'End date of the reconciliation period',
            period_year COMMENT 'Year of the reconciliation period',
            period_quarter COMMENT 'Quarter of the reconciliation period (1-4)',
            period_month_num COMMENT 'Month number of the reconciliation period (1-12)',
            total_assignments COMMENT 'Total number of reconciliation assignments for the entity',
            active_assignments COMMENT 'Number of currently active assignments',
            total_balance_gl COMMENT 'Total general ledger balance',
            total_balance_bank COMMENT 'Total bank balance',
            total_variance COMMENT 'Total absolute variance amount',
            total_reconciliations COMMENT 'Total number of reconciliation records',
            total_unreconciled_amount COMMENT 'Total amount remaining unreconciled',
            assignment_completion_rate COMMENT 'Percentage of assignments completed',
            ownership_percentage COMMENT 'Ownership percentage of the entity'
        )
        PRIMARY KEY (entity_id, period_id)
        COMMENT 'Entity-level 360 view with aggregated reconciliation metrics by period'
)
DIMENSIONS(
    entity_360.entity_id SYNONYMS ('entity identifier', 'org id'),
    entity_360.entity_code SYNONYMS ('entity number', 'org code'),
    entity_360.entity_name SYNONYMS ('organization name', 'company name', 'entity'),
    entity_360.entity_type SYNONYMS ('organization type', 'entity category'),
    entity_360.parent_name SYNONYMS ('parent entity', 'parent organization'),
    entity_360.hierarchy_depth SYNONYMS ('org level', 'hierarchy level'),
    entity_360.variance_risk_level SYNONYMS ('risk level', 'variance risk', 'risk category'),
    entity_360.period_end_date SYNONYMS ('period date', 'close date', 'reconciliation date'),
    entity_360.period_year SYNONYMS ('year', 'fiscal year'),
    entity_360.period_quarter SYNONYMS ('quarter', 'fiscal quarter'),
    entity_360.period_month_num SYNONYMS ('month', 'period month')
)
FACTS(
    entity_360.total_assignments SYNONYMS ('assignment count', 'number of assignments'),
    entity_360.active_assignments SYNONYMS ('active count', 'in-progress assignments'),
    entity_360.total_balance_gl SYNONYMS ('gl balance', 'general ledger balance'),
    entity_360.total_balance_bank SYNONYMS ('bank balance', 'cash balance'),
    entity_360.total_variance SYNONYMS ('variance amount', 'total variance'),
    entity_360.total_reconciliations SYNONYMS ('reconciliation count', 'number of reconciliations'),
    entity_360.total_unreconciled_amount SYNONYMS ('unreconciled balance', 'outstanding amount'),
    entity_360.assignment_completion_rate SYNONYMS ('completion percentage', 'completion rate'),
    entity_360.ownership_percentage SYNONYMS ('ownership', 'ownership pct')
)
METRICS(
    sum_total_variance AS SUM(entity_360.total_variance) SYNONYMS ('aggregate variance', 'total variance sum') COMMENT 'Sum of all variance amounts',
    sum_unreconciled AS SUM(entity_360.total_unreconciled_amount) SYNONYMS ('total unreconciled', 'aggregate unreconciled') COMMENT 'Sum of all unreconciled amounts',
    avg_completion_rate AS AVG(entity_360.assignment_completion_rate) SYNONYMS ('average completion', 'mean completion rate') COMMENT 'Average assignment completion rate',
    count_entities AS COUNT(DISTINCT entity_360.entity_id) SYNONYMS ('entity count', 'number of entities') COMMENT 'Count of distinct entities',
    count_high_risk_entities AS COUNT(CASE WHEN entity_360.variance_risk_level = 'High' THEN 1 END) SYNONYMS ('high risk count', 'risky entities') COMMENT 'Count of entities with high variance risk',
    sum_gl_balance AS SUM(entity_360.total_balance_gl) SYNONYMS ('total gl', 'aggregate gl balance') COMMENT 'Sum of general ledger balances',
    sum_bank_balance AS SUM(entity_360.total_balance_bank) SYNONYMS ('total bank', 'aggregate bank balance') COMMENT 'Sum of bank balances'
)
COMMENT = 'Comprehensive entity-level 360 view for financial reconciliation analysis'
