create or replace semantic view COCO_LIVE_DB.DBT.sv_entity_summary
  

TABLES(
  ent AS COCO_LIVE_DB.DBT.entity_reconciliation_summary
)

DIMENSIONS(
  ent.entity_id AS entity_id COMMENT 'Unique identifier for the entity',
  ent.entity_name AS entity_name COMMENT 'Name of the organizational entity' SYNONYMS ('entity', 'organization', 'company'),
  ent.entity_code AS entity_code COMMENT 'Code identifier for the entity' SYNONYMS ('org code'),
  ent.parent_entity_name AS parent_entity_name COMMENT 'Parent entity name' SYNONYMS ('parent'),
  ent.hierarchy_depth AS hierarchy_depth COMMENT 'Depth in hierarchy' SYNONYMS ('level'),
  ent.period_end_date AS period_end_date COMMENT 'End date of the period' SYNONYMS ('period', 'date', 'close date'),
  ent.period_year AS period_year COMMENT 'Year of the period' SYNONYMS ('year'),
  ent.period_quarter AS period_quarter COMMENT 'Quarter of the period' SYNONYMS ('quarter'),
  ent.period_month_name AS period_month_name COMMENT 'Month name' SYNONYMS ('month')
)

FACTS(
  ent.total_assignments AS total_assignments COMMENT 'Total assignments for the entity-period' SYNONYMS ('assignment count'),
  ent.active_assignments AS active_assignments COMMENT 'Active assignments count',
  ent.key_accounts AS key_accounts COMMENT 'Key account count' SYNONYMS ('critical accounts'),
  ent.total_gl_balance AS total_gl_balance COMMENT 'Total GL balance' SYNONYMS ('GL balance', 'book balance'),
  ent.total_bank_balance AS total_bank_balance COMMENT 'Total bank balance' SYNONYMS ('bank balance'),
  ent.total_variance AS total_variance COMMENT 'Total variance amount' SYNONYMS ('variance'),
  ent.reconciliation_completion_rate AS completion_rate COMMENT 'Reconciliation completion percentage' SYNONYMS ('rec rate', 'completion rate'),
  ent.fully_reconciled_count AS fully_reconciled_count COMMENT 'Count of fully reconciled assignments' SYNONYMS ('reconciled', 'completed'),
  ent.high_variance_count AS high_variance_count COMMENT 'Count of high variance assignments' SYNONYMS ('problems', 'issues')
)

METRICS(
  avg_completion_rate AS AVG(ent.reconciliation_completion_rate) COMMENT 'Average completion rate' SYNONYMS ('average completion'),
  sum_variance AS SUM(ent.total_variance) COMMENT 'Sum of all variances' SYNONYMS ('total variances'),
  entity_count AS COUNT(DISTINCT ent.entity_id) COMMENT 'Count of entities' SYNONYMS ('number of entities'),
  sum_assignments AS SUM(ent.total_assignments) COMMENT 'Total assignments across entities'
)

COMMENT='Entity-level reconciliation metrics for analyzing organizational performance by period'
