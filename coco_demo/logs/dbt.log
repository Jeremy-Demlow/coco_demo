create or replace semantic view COCO_LIVE_DB.DBT.sv_period_summary
  

TABLES(
  prd AS COCO_LIVE_DB.DBT.period_reconciliation_summary
)

DIMENSIONS(
  prd.period_id AS period_id COMMENT 'Unique identifier for the period',
  prd.period_end_date AS period_end_date COMMENT 'End date of the period' SYNONYMS ('period', 'close date', 'date'),
  prd.period_year AS period_year COMMENT 'Year of the period' SYNONYMS ('year'),
  prd.period_quarter AS period_quarter COMMENT 'Quarter of the period' SYNONYMS ('quarter'),
  prd.period_month_name AS period_month_name COMMENT 'Month name' SYNONYMS ('month')
)

FACTS(
  prd.total_assignments AS total_assignments COMMENT 'Total assignments in the period' SYNONYMS ('assignments'),
  prd.active_assignments AS active_assignments COMMENT 'Active assignments count' SYNONYMS ('active'),
  prd.entities_with_activity AS entities_with_activity COMMENT 'Number of entities with activity' SYNONYMS ('active entities'),
  prd.fully_reconciled AS fully_reconciled COMMENT 'Count of fully reconciled' SYNONYMS ('completed', 'reconciled'),
  prd.high_variance AS high_variance COMMENT 'Count of high variance' SYNONYMS ('problem accounts', 'issues'),
  prd.moderate_variance AS moderate_variance COMMENT 'Count of moderate variance',
  prd.total_variance AS total_variance COMMENT 'Total variance for the period' SYNONYMS ('variance amount'),
  prd.completion_rate_pct AS completion_rate COMMENT 'Completion percentage' SYNONYMS ('rec rate', 'completion rate'),
  prd.variance_alert_rate_pct AS variance_alert_rate COMMENT 'Percentage with material variances' SYNONYMS ('alert rate', 'issue rate'),
  prd.total_gl_balance AS total_gl_balance COMMENT 'Total GL balance' SYNONYMS ('GL balance'),
  prd.total_unidentified AS total_unidentified COMMENT 'Total unidentified amounts' SYNONYMS ('unreconciled')
)

METRICS(
  avg_completion AS AVG(prd.completion_rate_pct) COMMENT 'Average completion rate',
  sum_variance AS SUM(prd.total_variance) COMMENT 'Sum of all variances' SYNONYMS ('total variances'),
  period_count AS COUNT(DISTINCT prd.period_id) COMMENT 'Count of periods' SYNONYMS ('number of periods'),
  sum_assignments AS SUM(prd.total_assignments) COMMENT 'Total assignments across periods'
)

COMMENT='Period-level dashboard metrics for reconciliation health and variance trends'
[0m13:44:09.995226 [debug] [Thread-2 (]: Opening a new connection, currently in state init
[0m13:44:09.996582 [debug] [Thread-4 (]: On model.coco_demo.sv_reconciliation_360: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "model.coco_demo.sv_reconciliation_360"} */
create or replace semantic view COCO_LIVE_DB.DBT.sv_reconciliation_360
  

TABLES(
  rec AS COCO_LIVE_DB.DBT.reconciliation_360
)

DIMENSIONS(
  rec.assignment_id AS assignment_id COMMENT 'Unique identifier for the reconciliation assignment' SYNONYMS ('assignment', 'reconciliation assignment'),
  rec.assignment_key AS assignment_key COMMENT 'Business key for the assignment',
  rec.account_combination AS account_combination COMMENT 'General ledger account combination name' SYNONYMS ('account', 'GL account', 'combo'),
  rec.currency AS currency COMMENT 'Currency of the reconciliation' SYNONYMS ('currency code'),
  rec.entity_name AS entity_name COMMENT 'Name of the organizational entity' SYNONYMS ('entity', 'organization', 'company', 'business unit'),
  rec.entity_code AS entity_code COMMENT 'Code identifier for the entity' SYNONYMS ('org code'),
  rec.parent_entity_name AS parent_entity_name COMMENT 'Name of the parent entity in hierarchy' SYNONYMS ('parent', 'parent org'),
  rec.hierarchy_depth AS hierarchy_depth COMMENT 'Depth in the organizational hierarchy' SYNONYMS ('level', 'org level'),
  rec.reconciliation_status AS reconciliation_status COMMENT 'Current reconciliation status' SYNONYMS ('status', 'rec status'),
  rec.assignment_type AS assignment_type COMMENT 'Type of assignment',
  rec.purpose AS purpose COMMENT 'Purpose of the reconciliation',
  rec.reconciliation_procedure AS reconciliation_procedure COMMENT 'Procedure used for reconciliation',
  rec.is_active AS is_active COMMENT 'Whether the assignment is currently active' SYNONYMS ('active'),
  rec.is_key_account AS is_key_account COMMENT 'Whether this is a key account' SYNONYMS ('key account', 'critical account'),
  rec.financial_review_required AS financial_review_required COMMENT 'Whether financial review is required',
  rec.segment1 AS segment1 COMMENT 'Account segment 1',
  rec.segment2 AS segment2 COMMENT 'Account segment 2',
  rec.segment3 AS segment3 COMMENT 'Account segment 3',
  rec.period_end_date AS period_end_date COMMENT 'End date of the reconciliation period' SYNONYMS ('period', 'close date', 'date'),
  rec.period_year AS period_year COMMENT 'Year of the reconciliation period' SYNONYMS ('year'),
  rec.period_quarter AS period_quarter COMMENT 'Quarter of the reconciliation period' SYNONYMS ('quarter'),
  rec.period_month_name AS period_month_name COMMENT 'Month name of the period' SYNONYMS ('month'),
  rec.last_update_date AS last_update_date COMMENT 'Date of last update'
)

FACTS(
  rec.balance_gl AS balance_gl COMMENT 'General ledger balance amount' SYNONYMS ('GL balance', 'book balance'),
  rec.balance_bank AS balance_bank COMMENT 'Bank balance amount' SYNONYMS ('bank balance', 'cash balance'),
  rec.balance_subledger AS balance_subledger COMMENT 'Subledger balance amount',
  rec.balance_estimate AS balance_estimate COMMENT 'Estimated balance amount' SYNONYMS ('estimate'),
  rec.balance_forecast AS balance_forecast COMMENT 'Forecasted balance amount' SYNONYMS ('forecast'),
  rec.gl_bank_difference AS gl_bank_difference COMMENT 'Difference between GL and bank balances' SYNONYMS ('GL to bank diff'),
  rec.gl_subledger_difference AS gl_subledger_difference COMMENT 'Difference between GL and subledger',
  rec.total_abs_variance AS total_variance COMMENT 'Total variance for the assignment' SYNONYMS ('variance', 'variance amount'),
  rec.max_variance AS max_variance COMMENT 'Maximum variance amount' SYNONYMS ('peak variance'),
  rec.reconciliation_count AS reconciliation_count COMMENT 'Count of reconciliation records' SYNONYMS ('rec count'),
  rec.total_unidentified_amount AS unidentified_amount COMMENT 'Total unidentified amount' SYNONYMS ('unreconciled')
)

METRICS(
  total_gl_balance AS SUM(rec.balance_gl) COMMENT 'Sum of all GL balances' SYNONYMS ('sum of GL'),
  total_bank_balance AS SUM(rec.balance_bank) COMMENT 'Sum of all bank balances',
  total_variance_amount AS SUM(rec.total_abs_variance) COMMENT 'Sum of all variances' SYNONYMS ('total variances'),
  average_variance AS AVG(rec.total_abs_variance) COMMENT 'Average variance per assignment' SYNONYMS ('avg variance'),
  assignment_count AS COUNT(DISTINCT rec.assignment_id) COMMENT 'Count of assignments' SYNONYMS ('number of assignments'),
  active_assignment_count AS SUM(CASE WHEN rec.is_active THEN 1 ELSE 0 END) COMMENT 'Count of active assignments' SYNONYMS ('active assignments'),
  fully_reconciled_count AS SUM(CASE WHEN rec.reconciliation_status = 'Fully Reconciled' THEN 1 ELSE 0 END) COMMENT 'Count of fully reconciled' SYNONYMS ('reconciled count'),
  high_variance_count AS SUM(CASE WHEN rec.reconciliation_status = 'High Variance' THEN 1 ELSE 0 END) COMMENT 'Count of high variance assignments' SYNONYMS ('problem count'),
  completion_rate AS ROUND(100.0 * SUM(CASE WHEN rec.reconciliation_status = 'Fully Reconciled' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN rec.is_active THEN 1 ELSE 0 END), 0), 2) COMMENT 'Completion percentage' SYNONYMS ('rec rate', 'reconciliation rate'),
  key_account_count AS SUM(CASE WHEN rec.is_key_account THEN 1 ELSE 0 END) COMMENT 'Count of key accounts' SYNONYMS ('critical accounts')
)

COMMENT='Comprehensive 360-degree view of reconciliation assignments with entity, period, balance, and variance data for Cortex Analyst/Agent queries'
