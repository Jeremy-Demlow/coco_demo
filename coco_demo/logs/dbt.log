create or replace semantic view COCO_LIVE_DB.DBT.sv_entity_summary
  

TABLES(
  ent AS COCO_LIVE_DB.DBT.entity_reconciliation_summary
    PRIMARY KEY (entity_id, period_id)
    COMMENT = 'Entity-level reconciliation metrics'
)

DIMENSIONS(
  ent.entity_id AS entity_id
    COMMENT = 'Unique identifier for the entity',
  ent.entity_name AS entity_name
    WITH SYNONYMS = ('entity', 'organization', 'company')
    COMMENT = 'Name of the organizational entity',
  ent.entity_code AS entity_code
    WITH SYNONYMS = ('org code')
    COMMENT = 'Code identifier for the entity',
  ent.parent_entity_name AS parent_entity_name
    WITH SYNONYMS = ('parent')
    COMMENT = 'Parent entity name',
  ent.hierarchy_depth AS hierarchy_depth
    WITH SYNONYMS = ('level')
    COMMENT = 'Depth in hierarchy',
  ent.period_end_date AS period_end_date
    WITH SYNONYMS = ('period', 'date', 'close date')
    COMMENT = 'End date of the period',
  ent.period_year AS period_year
    WITH SYNONYMS = ('year')
    COMMENT = 'Year of the period',
  ent.period_quarter AS period_quarter
    WITH SYNONYMS = ('quarter')
    COMMENT = 'Quarter of the period',
  ent.period_month_name AS period_month_name
    WITH SYNONYMS = ('month')
    COMMENT = 'Month name'
)

FACTS(
  ent.total_assignments AS total_assignments
    WITH SYNONYMS = ('assignment count')
    COMMENT = 'Total assignments for the entity-period',
  ent.active_assignments AS active_assignments
    COMMENT = 'Active assignments count',
  ent.key_accounts AS key_accounts
    WITH SYNONYMS = ('critical accounts')
    COMMENT = 'Key account count',
  ent.total_gl_balance AS total_gl_balance
    WITH SYNONYMS = ('GL balance', 'book balance')
    COMMENT = 'Total GL balance',
  ent.total_bank_balance AS total_bank_balance
    WITH SYNONYMS = ('bank balance')
    COMMENT = 'Total bank balance',
  ent.total_variance AS total_variance
    WITH SYNONYMS = ('variance')
    COMMENT = 'Total variance amount',
  ent.reconciliation_completion_rate AS completion_rate
    WITH SYNONYMS = ('rec rate', 'completion rate')
    COMMENT = 'Reconciliation completion percentage',
  ent.fully_reconciled_count AS fully_reconciled_count
    WITH SYNONYMS = ('reconciled', 'completed')
    COMMENT = 'Count of fully reconciled assignments',
  ent.high_variance_count AS high_variance_count
    WITH SYNONYMS = ('problems', 'issues')
    COMMENT = 'Count of high variance assignments'
)

METRICS(
  ent.avg_completion_rate AS AVG(ent.reconciliation_completion_rate)
    WITH SYNONYMS = ('average completion')
    COMMENT = 'Average completion rate',
  ent.sum_variance AS SUM(ent.total_variance)
    WITH SYNONYMS = ('total variances')
    COMMENT = 'Sum of all variances',
  ent.entity_count AS COUNT(DISTINCT ent.entity_id)
    WITH SYNONYMS = ('number of entities')
    COMMENT = 'Count of entities',
  ent.sum_assignments AS SUM(ent.total_assignments)
    COMMENT = 'Total assignments across entities'
)

COMMENT = 'Entity-level reconciliation metrics for analyzing organizational performance by period'
