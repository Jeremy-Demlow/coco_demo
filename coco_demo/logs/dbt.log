create or replace semantic view COCO_LIVE_DB.DBT.sv_period_summary
  

TABLES(
  prd AS COCO_LIVE_DB.DBT.period_reconciliation_summary
    PRIMARY KEY (period_id)
    COMMENT = 'Period-level reconciliation dashboard metrics'
)

DIMENSIONS(
  prd.period_id AS period_id
    COMMENT = 'Unique identifier for the period',
  prd.period_end_date AS period_end_date
    WITH SYNONYMS = ('period', 'close date', 'date')
    COMMENT = 'End date of the period',
  prd.period_year AS period_year
    WITH SYNONYMS = ('year')
    COMMENT = 'Year of the period',
  prd.period_quarter AS period_quarter
    WITH SYNONYMS = ('quarter')
    COMMENT = 'Quarter of the period',
  prd.period_month_name AS period_month_name
    WITH SYNONYMS = ('month')
    COMMENT = 'Month name'
)

FACTS(
  prd.total_assignments AS total_assignments
    WITH SYNONYMS = ('assignments')
    COMMENT = 'Total assignments in the period',
  prd.active_assignments AS active_assignments
    WITH SYNONYMS = ('active')
    COMMENT = 'Active assignments count',
  prd.entities_with_activity AS entities_with_activity
    WITH SYNONYMS = ('active entities')
    COMMENT = 'Number of entities with activity',
  prd.fully_reconciled AS fully_reconciled
    WITH SYNONYMS = ('completed', 'reconciled')
    COMMENT = 'Count of fully reconciled',
  prd.high_variance AS high_variance
    WITH SYNONYMS = ('problem accounts', 'issues')
    COMMENT = 'Count of high variance',
  prd.moderate_variance AS moderate_variance
    COMMENT = 'Count of moderate variance',
  prd.total_variance AS total_variance
    WITH SYNONYMS = ('variance amount')
    COMMENT = 'Total variance for the period',
  prd.completion_rate_pct AS completion_rate
    WITH SYNONYMS = ('rec rate', 'completion rate')
    COMMENT = 'Completion percentage',
  prd.variance_alert_rate_pct AS variance_alert_rate
    WITH SYNONYMS = ('alert rate', 'issue rate')
    COMMENT = 'Percentage with material variances',
  prd.total_gl_balance AS total_gl_balance
    WITH SYNONYMS = ('GL balance')
    COMMENT = 'Total GL balance',
  prd.total_unidentified AS total_unidentified
    WITH SYNONYMS = ('unreconciled')
    COMMENT = 'Total unidentified amounts'
)

METRICS(
  prd.avg_completion AS AVG(prd.completion_rate_pct)
    COMMENT = 'Average completion rate',
  prd.sum_variance AS SUM(prd.total_variance)
    WITH SYNONYMS = ('total variances')
    COMMENT = 'Sum of all variances',
  prd.period_count AS COUNT(DISTINCT prd.period_id)
    WITH SYNONYMS = ('number of periods')
    COMMENT = 'Count of periods',
  prd.sum_assignments AS SUM(prd.total_assignments)
    COMMENT = 'Total assignments across periods'
)

COMMENT = 'Period-level dashboard metrics for reconciliation health and variance trends'
[0m13:45:51.666111 [debug] [Thread-2 (]: Opening a new connection, currently in state init
[0m13:45:51.667492 [debug] [Thread-4 (]: On model.coco_demo.sv_reconciliation_360: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "model.coco_demo.sv_reconciliation_360"} */
create or replace semantic view COCO_LIVE_DB.DBT.sv_reconciliation_360
  

TABLES(
  rec AS COCO_LIVE_DB.DBT.reconciliation_360
    PRIMARY KEY (assignment_id, period_id)
    COMMENT = 'Comprehensive 360-degree view of reconciliation assignments'
)

DIMENSIONS(
  rec.assignment_id AS assignment_id
    COMMENT = 'Unique identifier for the reconciliation assignment',
  rec.assignment_key AS assignment_key
    COMMENT = 'Business key for the assignment',
  rec.account_combination AS account_combination
    WITH SYNONYMS = ('account', 'GL account', 'combo')
    COMMENT = 'General ledger account combination name',
  rec.currency AS currency
    WITH SYNONYMS = ('currency code')
    COMMENT = 'Currency of the reconciliation',
  rec.entity_name AS entity_name
    WITH SYNONYMS = ('entity', 'organization', 'company', 'business unit')
    COMMENT = 'Name of the organizational entity',
  rec.entity_code AS entity_code
    WITH SYNONYMS = ('org code')
    COMMENT = 'Code identifier for the entity',
  rec.parent_entity_name AS parent_entity_name
    WITH SYNONYMS = ('parent', 'parent org')
    COMMENT = 'Name of the parent entity in hierarchy',
  rec.hierarchy_depth AS hierarchy_depth
    WITH SYNONYMS = ('level', 'org level')
    COMMENT = 'Depth in the organizational hierarchy',
  rec.reconciliation_status AS reconciliation_status
    WITH SYNONYMS = ('status', 'rec status')
    COMMENT = 'Current reconciliation status',
  rec.assignment_type AS assignment_type
    COMMENT = 'Type of assignment',
  rec.purpose AS purpose
    COMMENT = 'Purpose of the reconciliation',
  rec.reconciliation_procedure AS reconciliation_procedure
    COMMENT = 'Procedure used for reconciliation',
  rec.is_active AS is_active
    WITH SYNONYMS = ('active')
    COMMENT = 'Whether the assignment is currently active',
  rec.is_key_account AS is_key_account
    WITH SYNONYMS = ('key account', 'critical account')
    COMMENT = 'Whether this is a key account',
  rec.financial_review_required AS financial_review_required
    COMMENT = 'Whether financial review is required',
  rec.segment1 AS segment1
    COMMENT = 'Account segment 1',
  rec.segment2 AS segment2
    COMMENT = 'Account segment 2',
  rec.segment3 AS segment3
    COMMENT = 'Account segment 3',
  rec.period_end_date AS period_end_date
    WITH SYNONYMS = ('period', 'close date', 'date')
    COMMENT = 'End date of the reconciliation period',
  rec.period_year AS period_year
    WITH SYNONYMS = ('year')
    COMMENT = 'Year of the reconciliation period',
  rec.period_quarter AS period_quarter
    WITH SYNONYMS = ('quarter')
    COMMENT = 'Quarter of the reconciliation period',
  rec.period_month_name AS period_month_name
    WITH SYNONYMS = ('month')
    COMMENT = 'Month name of the period',
  rec.last_update_date AS last_update_date
    COMMENT = 'Date of last update'
)

FACTS(
  rec.balance_gl AS balance_gl
    WITH SYNONYMS = ('GL balance', 'book balance')
    COMMENT = 'General ledger balance amount',
  rec.balance_bank AS balance_bank
    WITH SYNONYMS = ('bank balance', 'cash balance')
    COMMENT = 'Bank balance amount',
  rec.balance_subledger AS balance_subledger
    COMMENT = 'Subledger balance amount',
  rec.balance_estimate AS balance_estimate
    WITH SYNONYMS = ('estimate')
    COMMENT = 'Estimated balance amount',
  rec.balance_forecast AS balance_forecast
    WITH SYNONYMS = ('forecast')
    COMMENT = 'Forecasted balance amount',
  rec.gl_bank_difference AS gl_bank_difference
    WITH SYNONYMS = ('GL to bank diff')
    COMMENT = 'Difference between GL and bank balances',
  rec.gl_subledger_difference AS gl_subledger_difference
    COMMENT = 'Difference between GL and subledger',
  rec.total_abs_variance AS total_variance
    WITH SYNONYMS = ('variance', 'variance amount')
    COMMENT = 'Total variance for the assignment',
  rec.max_variance AS max_variance
    WITH SYNONYMS = ('peak variance')
    COMMENT = 'Maximum variance amount',
  rec.reconciliation_count AS reconciliation_count
    WITH SYNONYMS = ('rec count')
    COMMENT = 'Count of reconciliation records',
  rec.total_unidentified_amount AS unidentified_amount
    WITH SYNONYMS = ('unreconciled')
    COMMENT = 'Total unidentified amount'
)

METRICS(
  rec.total_gl_balance AS SUM(rec.balance_gl)
    WITH SYNONYMS = ('sum of GL')
    COMMENT = 'Sum of all GL balances',
  rec.total_bank_balance AS SUM(rec.balance_bank)
    COMMENT = 'Sum of all bank balances',
  rec.total_variance_amount AS SUM(rec.total_abs_variance)
    WITH SYNONYMS = ('total variances')
    COMMENT = 'Sum of all variances',
  rec.average_variance AS AVG(rec.total_abs_variance)
    WITH SYNONYMS = ('avg variance')
    COMMENT = 'Average variance per assignment',
  rec.assignment_count AS COUNT(DISTINCT rec.assignment_id)
    WITH SYNONYMS = ('number of assignments')
    COMMENT = 'Count of assignments',
  rec.active_assignment_count AS SUM(CASE WHEN rec.is_active THEN 1 ELSE 0 END)
    WITH SYNONYMS = ('active assignments')
    COMMENT = 'Count of active assignments',
  rec.fully_reconciled_count AS SUM(CASE WHEN rec.reconciliation_status = 'Fully Reconciled' THEN 1 ELSE 0 END)
    WITH SYNONYMS = ('reconciled count')
    COMMENT = 'Count of fully reconciled',
  rec.high_variance_count AS SUM(CASE WHEN rec.reconciliation_status = 'High Variance' THEN 1 ELSE 0 END)
    WITH SYNONYMS = ('problem count')
    COMMENT = 'Count of high variance assignments',
  rec.completion_rate AS ROUND(100.0 * SUM(CASE WHEN rec.reconciliation_status = 'Fully Reconciled' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN rec.is_active THEN 1 ELSE 0 END), 0), 2)
    WITH SYNONYMS = ('rec rate', 'reconciliation rate')
    COMMENT = 'Completion percentage',
  rec.key_account_count AS SUM(CASE WHEN rec.is_key_account THEN 1 ELSE 0 END)
    WITH SYNONYMS = ('critical accounts')
    COMMENT = 'Count of key accounts'
)

COMMENT = 'Comprehensive 360-degree view of reconciliation assignments with entity, period, balance, and variance data for Cortex Analyst/Agent queries'
